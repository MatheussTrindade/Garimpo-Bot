# Copie para `.env` e preencha. O `.env` está no .gitignore — nunca o versione.

# --- Telegram (obrigatório) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Fontes de Threat Intel (opcionais, aumentam rate limit / habilitam fontes) ---
NVD_API_KEY=
GITHUB_TOKEN=
ABUSECH_AUTH_KEY=

# --- Execução ---
POLL_INTERVAL_MINUTES=30
LOG_LEVEL=INFO
DB_PATH=data/atalaia.db
WATCHLIST_PATH=config/watchlist.yaml
